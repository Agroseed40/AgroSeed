# Local development only. Do not put real credentials in this file.
NODE_ENV=development
PORT=3000
AGROSEED_DEMO_MODE=true
# Local preview only. Set this in your shell; never use the sample value.
AGROSEED_ADMIN_PASSWORD=
# Local preview guard. Disable if you do not need demo orders.
AGROSEED_ALLOW_SANDBOX_ORDERS=true

# Set this to false in GoDaddy PUBLISH until the production database, catalog,
# order flow, and customer services are ready.
# Set it to true in GoDaddy PREVIEW to keep mock features available for testing.
# Configure these independently in each GoDaddy variant's app settings.
# Customer authentication uses GoDaddy MySQL. Supply either DATABASE_URL or
# these DB_* settings from the GoDaddy database details. Never commit values.
# DATABASE_URL=mysql://user:password@host:3306/database
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# PAYMENT_MODE=test
# PAYMENT_KEY_ID=
# PAYMENT_KEY_SECRET=
